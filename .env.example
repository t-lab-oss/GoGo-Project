# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:4200

# MongoDB (Atlas M0 hoặc local)
MONGODB_URI=mongodb://127.0.0.1:27017/gogo

# JWT access token (15 phút). Refresh token lưu băm trong collection refreshTokens
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-dai
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Supabase Storage (bucket private)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=gogo-moments

# Google Places API (New). Đặt quota theo ngày trên Google Cloud, PLACES_DAILY_CAP là cap phía app
GOOGLE_PLACES_API_KEY=
PLACES_DAILY_CAP=200

# Ảnh minh hoạ món ăn cho thẻ quán lấy từ Wikimedia Commons, không cần khoá.
# Gemini là tuỳ chọn: đổi tên món sang từ khoá tiếng Anh để tìm được nhiều ảnh hơn.
GEMINI_API_KEY=
# Tên model Gemini. Nếu gọi báo lỗi, kiểm tra lại tên model hiện hành trong Google AI Studio.
GEMINI_MODEL=gemini-2.5-flash
