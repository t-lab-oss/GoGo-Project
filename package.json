{
  "name": "gogo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve web --proxy-config proxy.conf.json",
    "build": "ng build web",
    "watch": "ng build web --watch --configuration development",
    "test:web": "ng test web --watch=false",
    "preview": "ng build web && node scripts/preview.mjs",
    "dev:server": "tsx watch server/src/server.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start:api": "node dist/server/src/server.js",
    "test:server": "vitest run",
    "seed": "tsx server/seed/seed.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "db:start": "mkdir -p .data/mongo && ${MONGOD_BIN:-mongod} --dbpath .data/mongo --bind_ip 127.0.0.1"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.25",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "idb": "^8.0.4",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "mongoose": "^9.12.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.7.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "mongodb-memory-server": "^11.4.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vitest": "^5.1.1"
  }
}
